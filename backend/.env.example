API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173
# relative paths are resolved against backend/
CHROMA_DIR=data/chroma
GRAPH_REPO_DIR=data/graph_repo
EMBEDDING_MODEL=all-MiniLM-L6-v2
# auto | sentence-transformers | hash (hash = tiny offline embedder, no model download)
EMBEDDING_BACKEND=auto
AUTO_COMMIT_EVERY=25
AUTO_COMMIT_SECONDS=60

# Optional: Claude writes the answer shown in the SYNTHESIZE phase.
# Without a key the brain uses an extractive summary of the top memories.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=2000
ANTHROPIC_FALLBACKS=true
