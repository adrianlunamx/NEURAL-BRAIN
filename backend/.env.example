# ─────────────────────────────────────────────────────────────
#  neural-brain · backend configuration
#  Copy to `.env` and fill in your key:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# REQUIRED for real answers. Without it the brain runs in "offline mode"
# (search + graph + animations work; answers are extractive summaries).
ANTHROPIC_API_KEY=

# Claude model + reasoning effort (low | medium | high | xhigh | max)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=4000
# Re-run a declined request on a fallback model chosen by the API (true/false)
ANTHROPIC_FALLBACKS=true

# Embeddings: sentence-transformers model name.
# For Spanish-heavy notes try: paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=all-MiniLM-L6-v2
# auto | sentence-transformers | hash   (hash = tiny offline embedder, no downloads)
EMBEDDING_BACKEND=auto

# Retrieval / graph tuning
TOP_K=5
LINK_THRESHOLD=0.35
MAX_LINKS_PER_NODE=4
# brain = anatomical human-brain layout | force = force-directed with type clusters
LAYOUT_MODE=brain
LAYOUT_ITERATIONS=200

# Storage + server
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
